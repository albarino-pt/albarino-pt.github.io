---
export const prerender = true;
import PageHeading from "../../components/page-heading.astro";
import PostsLoop from "../../components/projects-loop.astro";
import Layout from "../../layouts/main.astro";
---

<Layout title="Portfolio">
  <section class="relative z-20 max-w-2xl mx-auto my-12 px-7 lg:px-0">
    <PageHeading
      title="Portfolio"
      description="A selection of web development work I've done: full-stack apps, business sites and client platforms. Built with modern tools and self-hosted where it makes sense."
    />

    <div
      class="z-50 grid items-stretch w-full grid-cols-1 my-8 gap-7 sm:gap-5 sm:grid-cols-2"
    >
      <PostsLoop count="999999999" prefix="w" />
    </div>
  </section>
</Layout>
